# 复制为 .env 后按需修改；compose 自动读取

# MySQL root 密码（注意：改动后需同步 init/10-seed.sql 中 mysql-poll source 的 password）
MYSQL_ROOT_PASSWORD=magpie-soak

# RabbitMQ 账号与集群 cookie（stream URI 与集群组网共用）
RABBITMQ_USER=magpie
RABBITMQ_PASSWORD=magpie
RABBITMQ_ERLANG_COOKIE=magpie-soak-cookie

# Grafana 访问（整个环境唯一对外端口）
# 绑定地址：默认 0.0.0.0 公开访问（匿名只读看板）；收紧改 127.0.0.1（仅 ssh -L 隧道）
SOAK_GRAFANA_BIND=0.0.0.0
SOAK_GRAFANA_PORT=3000

# 匿名只读：true = 无需登录可看板（仅 Viewer），密码只管 admin 操作；
#           false = 登录才能看（不想暴露数据时选这个）
GRAFANA_ANONYMOUS_ENABLED=true

# admin 密码：端口公开，务必改成强密码。Grafana 走 HTTP 明文（凭据可被同网段嗅探），
# 不要复用任何重要密码；有 TLS 反向代理（nginx/traefik）则挂在代理后面更稳妥
GRAFANA_ADMIN_PASSWORD=admin

# 负载强度：全局发送速率（msg/s）与每 topic 的 key 数。
# 速率上限 ≈ 链数(topics×keyCount) ÷ 单次发布往返延迟——要更高吞吐先加 keyCount 再提速率
LOADGEN_RATE_PER_SEC=3000
LOADGEN_KEY_COUNT=40

# 被测系统与 harness 镜像（默认本地构建产物；测发布版可换成 ghcr.io tag）
MAGPIE_IMAGE=local/magpie-server:latest
TESTKIT_IMAGE=local/magpie-testkit:latest

# 自动化故障注入：取消注释启用 chaos 服务（注意：该容器持有宿主机 Docker 全权）
COMPOSE_PROFILES=chaos
# 注入间隔（秒）：在最小~最大之间随机
CHAOS_MIN_INTERVAL=600
CHAOS_MAX_INTERVAL=1200
