{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "发送速率 (msg/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by(topic) (rate(testkit_sent_total[5m]))", "legendFormat": "{{topic}}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "接收速率 (msg/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum by(channel) (rate(testkit_received_total[5m]))", "legendFormat": "{{channel}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "title": "语义违规（丢失 / 乱序，累计）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by(channel) (testkit_lost_total)", "legendFormat": "lost {{channel}}", "refId": "A"},
        {"expr": "sum by(channel) (testkit_out_of_order_total)", "legendFormat": "out_of_order {{channel}}", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "title": "重复投递速率 (msg/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by(channel) (rate(testkit_duplicates_total[5m]))", "legendFormat": "{{channel}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "title": "端到端延迟",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by(le, channel) (rate(testkit_e2e_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{channel}}", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by(le, channel) (rate(testkit_e2e_latency_seconds_bucket[5m])))", "legendFormat": "p99 {{channel}}", "refId": "B"}
      ]
    },
    {
      "id": 6,
      "title": "无效探针（累计）",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum by(channel) (testkit_invalid_total)", "legendFormat": "{{channel}}", "refId": "A"}
      ]
    },
    {
      "id": 7,
      "title": "Magpie JVM 堆内存",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"expr": "sum by(instance) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "title": "RabbitMQ 连接数",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "rabbitmq_connections", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["magpie", "soak"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Magpie Soak",
  "version": 1
}
