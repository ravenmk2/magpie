FROM eclipse-temurin:25-jre AS builder
WORKDIR /build
COPY magpie-testkit/target/magpie-testkit-*.jar app.jar
RUN java -Djarmode=tools -jar app.jar extract --layers --application-filename app.jar --destination extracted

# ----------------------------------------------------------------------------------------------------

FROM eclipse-temurin:25-jre

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/logs \
    && chown 1000:1000 /app/logs

WORKDIR /app

COPY --from=builder --chown=1000:1000 /build/extracted/dependencies/ ./
COPY --from=builder --chown=1000:1000 /build/extracted/spring-boot-loader/ ./
COPY --from=builder --chown=1000:1000 /build/extracted/snapshot-dependencies/ ./
COPY --from=builder --chown=1000:1000 /build/extracted/application/ ./

USER 1000
EXPOSE 8080
# 角色由 SPRING_PROFILES_ACTIVE=loadgen|verifier 决定
ENTRYPOINT ["java", "-jar", "app.jar"]
